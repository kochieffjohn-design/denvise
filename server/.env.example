# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git — ключ OpenRouter не должен утечь в репозиторий.

# Получить ключ: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Модель диалога через OpenRouter (id смотри на https://openrouter.ai/models —
# провайдеры выпускают новые версии, актуальность проверяйте там).
# Варианты на выбор (июль 2026):
#   deepseek/deepseek-v4-flash   — по умолчанию. Дёшево (~$0.09 / $0.18 за 1M
#                                   токенов вход/выход), 1M контекста, быстрый.
#   deepseek/deepseek-v4-pro     — сильнее в рассуждениях, дороже (~$0.435/$0.87).
#   qwen/qwen3.6-plus            — сильная альтернатива Qwen (~$0.325/$1.95),
#                                   1M контекста, поддерживает prompt caching.
#   qwen/qwen3.6-flash           — более дешёвый Qwen (~$0.19/$1.13).
# System-промпт ДентИИ ~43К токенов (по данным OpenRouter) — с запасом
# влезает в любой из вариантов выше. На deepseek-v4-flash вопрос стоит
# ~$0.004 без кеша и ~$0.001 при попадании в кеш (замер, сентябрь 2026).
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Необязательно: используются как заголовки HTTP-Referer/X-Title в запросах
# к OpenRouter — попадают в статистику/рейтинги на openrouter.ai, на работу
# API не влияют.
APP_URL=https://denvise.app

# Порт, на котором поднимется сервер
PORT=8787

# Домен(ы), которым разрешено дёргать API (для веб-версии/Expo web).
# Мобильному приложению (iOS/Android) это не критично, но лучше не оставлять
# "*" в проде, если появится веб-клиент.
CORS_ORIGIN=*
