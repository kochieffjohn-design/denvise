{
  "expo": {
    "name": "Denvise",
    "slug": "denvise",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.denvise.app"
    },
    "android": {
      "package": "com.denvise.app"
    },
    "scheme": "denvise",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
