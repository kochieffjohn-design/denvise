{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npx expo export -p web",
    "watchPatterns": [
      "app/**",
      "assets/**",
      "components/**",
      "constants/**",
      "data/**",
      "hooks/**",
      "public/**",
      ".env",
      "app.json",
      "package.json",
      "package-lock.json",
      "railway.web.json"
    ]
  },
  "deploy": {
    "startCommand": "npx --yes serve@14 --single dist --listen $PORT",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
